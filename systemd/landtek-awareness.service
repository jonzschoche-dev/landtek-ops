[Unit]
Description=LandTek awareness loop — accrete knowledge autonomously: harvest free structured facts, comprehend (Gemini, as quota allows), log the awareness score. The system gets smarter on its own; the score is the tripwire if it stops.
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/root/landtek/.env
WorkingDirectory=/root/landtek
# 1) SERIOUS bulk populate: full doc text → document_fields + titles + matter_facts + parties
ExecStart=-/usr/bin/python3 /root/landtek/scripts/populate_tables_from_docs.py --go
# 2) FREE regex harvest (titles/dates/amounts per matter) — complements doc populate
ExecStart=-/usr/bin/python3 /root/landtek/scripts/harvest_facts.py --all --go
# 3) Typed decomposition: matter_facts prose → fact_fields
ExecStart=-/usr/bin/python3 /root/landtek/scripts/extract_fact_fields.py --go
# 4) Materialize matter + title cards
ExecStart=-/usr/bin/python3 /root/landtek/scripts/materialize_matter_brief.py --go
ExecStart=-/usr/bin/python3 /root/landtek/scripts/materialize_title_brief.py --go
# 5) Intake / clarity meter (90% target; unclear flagged for human queue)
ExecStart=-/usr/bin/python3 /root/landtek/scripts/intake_clarity_report.py --log --queue 0
# 6) LLM comprehension residual (optional; never blocks tables)
ExecStart=-/usr/bin/python3 /root/landtek/scripts/comprehend.py --sweep --limit 40 --rpm 8 --go
# 7) awareness score
ExecStart=-/usr/bin/python3 /root/landtek/scripts/knowledge_coverage.py --log
StandardOutput=append:/var/log/landtek_awareness.log
StandardError=append:/var/log/landtek_awareness.log
